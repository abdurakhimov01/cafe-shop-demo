# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; this file is the template and must never hold
# a working credential.

# Postgres connection string. A free Neon database (neon.tech) is enough —
# copy the "Pooled connection" string it gives you after signup.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Password for /admin. Any long random string; the guest side never uses it.
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"
